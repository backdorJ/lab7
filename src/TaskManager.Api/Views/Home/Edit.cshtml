@model TaskItem
@{
    ViewData["Title"] = "Редактирование";
}

<section class="page-head">
    <div>
        <p class="eyebrow">Задача @Model.Id</p>
        <h1>Редактирование</h1>
    </div>
    <a class="text-link" asp-action="Index">К списку</a>
</section>

<form class="card" asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="Id" />
    <partial name="_TaskForm" model="Model" />
    <div class="form-actions">
        <button type="submit">Сохранить</button>
        <a asp-action="Index">Отмена</a>
    </div>
</form>
