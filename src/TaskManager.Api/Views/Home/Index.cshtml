@model IReadOnlyList<TaskItem>
@{
    ViewData["Title"] = "Задачи";
    var query = ViewData["Query"] as string;
}

<section class="page-head">
    <div>
        <p class="eyebrow">Лабораторная работа 7</p>
        <h1>Задачи</h1>
    </div>
    <a class="button" asp-action="Create">Добавить</a>
</section>

<form class="search" method="get" asp-action="Index">
    <input type="search" name="q" value="@query" placeholder="Поиск по названию и описанию" />
    <button type="submit">Найти</button>
    @if (!string.IsNullOrEmpty(query))
    {
        <a asp-action="Index">Сбросить</a>
    }
</form>

@if (Model.Count == 0)
{
    <p class="empty">Задач нет.</p>
}
else
{
    <table class="tasks">
        <thead>
            <tr>
                <th>Название</th>
                <th>Срок</th>
                <th>Статус</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.IsDone ? "is-done" : null)">
                <td>
                    <strong>@item.Title</strong>
                    @if (!string.IsNullOrWhiteSpace(item.Description))
                    {
                        <span>@item.Description</span>
                    }
                </td>
                <td>@item.DueDate.ToString("dd.MM.yyyy")</td>
                <td>@(item.IsDone ? "Готово" : "В работе")</td>
                <td class="actions">
                    <a asp-action="Edit" asp-route-id="@item.Id">Изменить</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Удалить задачу?');">
                        <button type="submit">Удалить</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
